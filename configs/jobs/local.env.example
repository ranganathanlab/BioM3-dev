# Local defaults for cloud launches. Copy to configs/jobs/local.env (gitignored)
# for values you would rather keep out of version control.
# scripts/cloud/mithril_launch.sh auto-loads local.env via --env-file when present:
# these values override the defaults in cloud/*.yaml, and --env on the command
# line overrides these.

# Override the image (default is the public GHCR dev image).
# IMAGE=ghcr.io/natural-machine/biom3:cuda-dev

# Variables passed into the container, e.g. names your own upload in CMD needs.
# FORWARD_ENV="WANDB_API_KEY BIOM3_WEIGHTS_BUNDLE MY_STORAGE_TOKEN"
