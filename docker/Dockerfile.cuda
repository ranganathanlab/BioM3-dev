# BioM3 — NVIDIA CUDA image (biom3:cuda), for any NVIDIA host with Docker (a
# workstation, a cloud GPU instance) and, under Apptainer, ALCF Polaris.
# The Intel-XPU variant is docker/Dockerfile.xpu; the CPU-only inference variant
# is docker/Dockerfile.cpu.
#
# One image per device, all uses: training (all stages), finetuning, generation,
# and the streamlit app. The command is chosen at `docker run` time.
#
# Arch-portable: build for x86_64 (AWS p3/p4/p5, g4/g5/g6; Mithril H100/H200)
# or ARM64 (Grace / GH200) from THIS SAME Dockerfile — there are no arch
# conditionals. The nvidia/cuda base is a multi-arch manifest and the cu129
# torch index serves both x86_64 and aarch64 wheels; pip selects by platform.
# Choose the arch with `docker buildx build --platform linux/{amd64,arm64}`
# (see docker/build.sh).
#
# TWO STAGES. The build stage needs a C/C++ toolchain and MPI headers (mpi4py is
# the only source build); the runtime stage needs neither, so it starts from the
# `base` CUDA image instead of `devel`. This matters a lot for size: the torch
# cu129 wheel ships its OWN complete set of CUDA libraries in
# site-packages/torch/lib (cudart, cublas, cuDNN, NCCL, cuFFT, cuSPARSE,
# cuSOLVER, cuRAND, nvrtc, cuPTI) and resolves them through its RUNPATH, and
# triton ships its own ptxas. A -cudnn-devel base therefore duplicates ~9.5 GB
# of libraries, static archives and nvcc that nothing at run time opens.
#
# Build context is the BioM3-dev repo ROOT (so source + requirements are in
# scope). Build with docker/build.sh, or:
#   docker buildx build -f docker/Dockerfile.cuda -t biom3:cuda --load .
#
# Polaris runs this same image under Apptainer (scripts/polaris/apptainer_run.sh,
# docs/setup/setup_polaris_container.md). Aurora is Intel and uses
# docker/Dockerfile.xpu and docker/Dockerfile.xpu-oneapi.

ARG CUDA_VERSION=12.9.0
ARG UBUNTU_VERSION=ubuntu24.04

# =============================================================================
# Stage 1 — builder. Plain Ubuntu, not a CUDA image: every CUDA library in the
# final venv arrives as part of a pip wheel, so no CUDA toolkit is needed to
# assemble it.
# =============================================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Build-only system deps:
#  - python3.12: matches BioM3-dev's required Python (Ubuntu 24.04 ships 3.12).
#  - build-essential, python3.12-dev: source builds for deps without wheels.
#  - libopenmpi-dev: mpi4py (in requirements) is the one such build.
#  - git, ca-certificates: pip may resolve git+https URLs from dependencies.
#  - curl: fetches the oras binary below.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv \
        build-essential git ca-certificates curl \
        libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

# oras — pulls the GHCR weights bundle (see scripts/weights_bundle/ and the
# BIOM3_WEIGHTS_BUNDLE hook in docker/entrypoint.sh). TARGETARCH is set by
# buildx per platform, and oras publishes matching linux_amd64 / linux_arm64
# release tarballs, so this stays correct in the multi-arch build.
ARG ORAS_VERSION=1.3.3
ARG TARGETARCH
RUN curl -fsSL -o /tmp/oras.tar.gz \
        "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && tar -xzf /tmp/oras.tar.gz -C /usr/local/bin oras \
    && rm /tmp/oras.tar.gz \
    && oras version

ENV VIRTUAL_ENV=/opt/venv
RUN python3.12 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --upgrade pip setuptools wheel

# Torch with the cu129 wheel — must come before requirements so the pinned
# torch isn't replaced by a CPU wheel during dependency resolution. pip picks
# the x86_64 or aarch64 wheel automatically based on --platform.
RUN pip install torch==2.8.0 torchvision \
        --index-url https://download.pytorch.org/whl/cu129

# Requirements layer is cached independently of the source. requirements/spark.txt
# is the general post-torch pinned set (numpy/transformers/deepspeed/etc.); the
# "spark" name is historical — it is not DGX-Spark-specific.
WORKDIR /app
COPY requirements/ /app/requirements/
RUN pip install -r requirements/spark.txt

# BioM3 source. Explicit paths (no `COPY . .`) so we never bake weights/, data/,
# outputs/, logs/, or jobs/ into the image. configs/ IS baked in: it is tiny,
# repo-versioned, and matches the code revision (unlike weights/data, which are
# large and mounted/synced at runtime). Add new BioM3 top-level dirs here as
# they are introduced.
COPY pyproject.toml environment.sh README.md /app/
COPY src/      /app/src/
COPY scripts/  /app/scripts/
COPY tests/    /app/tests/
COPY configs/  /app/configs/

# Editable install with the `app` extra so the same image can also serve
# `biom3_app` (streamlit). The .pth this writes points at /app/src, which the
# runtime stage reproduces at the same path.
RUN pip install -e ".[app]"

# =============================================================================
# Stage 2 — runtime. `base` carries libcudart plus cuda-compat (forward
# compatibility for hosts on an older driver); libcuda itself is injected by the
# NVIDIA Container Toolkit. Everything else comes from the venv.
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-base-${UBUNTU_VERSION} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1 \
    BIOM3_MACHINE=container

# Runtime system deps only — no C++ toolchain, no CUDA headers, no static
# archives:
#  - python3.12: the interpreter /opt/venv symlinks to.
#  - cuda-nvcc: REQUIRED, not optional. `import deepspeed` probes
#    $CUDA_HOME/bin/nvcc -V from op_builder's is_compatible() and raises
#    FileNotFoundError without it, which would break every Stage 3 entry point
#    (biom3.Stage3.PL_wrapper imports deepspeed at module scope). 553 MB, versus
#    the 5.1 GB the full cuda-command-line-tools + dev packages cost.
#  - openmpi-bin: libmpi.so.40 for mpi4py, and mpiexec for the multinode
#    launchers. Multi-GPU on one node uses torchrun, not mpiexec.
#  - libgomp1: OpenMP runtime for the scientific-stack wheels.
#  - git, curl, ca-certificates: dependency fetches and the entrypoint's hooks.
ARG CUDA_APT_SUFFIX=12-9
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        cuda-nvcc-${CUDA_APT_SUFFIX} \
        openmpi-bin libgomp1 \
        git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Escape hatch, off by default: DeepSpeed JIT-compiles cpu_adam against a C++
# compiler and the CUDA headers on first use of DeepSpeedCPUAdam or ZeRO
# optimizer/parameter offload. No BioM3 config takes that path (every
# stage3_training config uses choose_optim=AdamW, and DeepSpeedStrategy is
# constructed without offload), so the toolchain is omitted. Re-add it — and
# ~2 GB — with `--build-arg INSTALL_BUILD_TOOLS=true`.
ARG INSTALL_BUILD_TOOLS=false
RUN if [ "$INSTALL_BUILD_TOOLS" = "true" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            build-essential python3.12-dev \
            cuda-cudart-dev-${CUDA_APT_SUFFIX} \
            libcublas-dev-${CUDA_APT_SUFFIX} \
            libcurand-dev-${CUDA_APT_SUFFIX} \
        && rm -rf /var/lib/apt/lists/*; \
    fi

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY --from=builder /usr/local/bin/oras /usr/local/bin/oras
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

WORKDIR /app

# Runtime mount points (empty in the image; bind-mounted or synced at run time).
RUN mkdir -p /app/weights /app/data /app/outputs /app/logs

# Entrypoint from the repo's docker/ directory.
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
