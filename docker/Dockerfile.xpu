# BioM3 — Intel XPU image (biom3:xpu) for Aurora (ALCF) via Apptainer.
# The NVIDIA-CUDA variant is docker/Dockerfile.cuda.
#
# One image per device, all uses: training (all stages), finetuning, generation,
# and the streamlit app. The command is chosen at run time.
#
# amd64 ONLY: Intel GPU torch wheels are x86_64-only (no aarch64), and Aurora is
# x86_64 — so, unlike the CUDA variant, there is no arm64 build here.
#
# TARGET = Aurora, run under Apptainer (NOT docker). The usual flow is:
#   docker/build.sh --variant xpu --release --repo ghcr.io/<org>/biom3  # -> :xpu-dev + :xpu-<sha>
#   apptainer build biom3_xpu.sif docker://ghcr.io/<org>/biom3:xpu-dev   # on Aurora
#   scripts/aurora/apptainer_run.sh <cmd>    # binds /flare, runs
# See docs/setup/setup_aurora_container.md for the full runbook.
# It can also `docker run` on a local Intel-GPU host (docker/run.sh maps :xpu
# tags to `--device /dev/dri`). The entrypoint does not source environment.sh,
# so run `source environment.sh` before the scripts/*_train_*.sh wrappers there.
#
# GPU ENABLEMENT — how this actually reaches Aurora's Ponte Vecchio GPUs:
#   * torch==2.8.0+xpu (below) has native torch.xpu, and torch.distributed uses
#     the native `xccl` backend (not the old `ccl`). IPEX is installed too; see
#     that layer below for why.
#   * The torch wheel vendors the SYCL/DPC++ *runtime*. What must come from
#     OUTSIDE the wheel is the Level-Zero loader + the Intel L0 GPU *driver*
#     (libze_intel_gpu). We install those from Intel's GPU apt repo so the image
#     is self-contained on any Intel-GPU host. On Aurora, Apptainer's default
#     /dev mount reaches the kernel driver — do NOT bind /dev/dri explicitly,
#     which remounts it `nodev` and hides the GPUs.
#     NOTE: if the in-image L0 driver ever mismatches Aurora's kernel driver,
#     the fallback is to bind the host runtime instead — see
#     docs/setup/setup_aurora_container.md.
#
# Build context is the BioM3-dev repo ROOT. Build with docker/build.sh, or:
#   docker buildx build -f docker/Dockerfile.xpu -t biom3:xpu --load .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# BIOM3_MACHINE is deliberately NOT set here (unlike Dockerfile.cuda, which pins
# it to `container`). Under Apptainer on Aurora, /flare is bound, so leaving it
# unset lets environment.sh auto-detect `aurora` and apply the oneCCL/xccl/
# NUMEXPR settings. On a generic Intel host with no /flare, it falls back to
# `container`. See the detection block in environment.sh.

# System deps:
#  - python3.12: matches BioM3-dev's required Python (Ubuntu 24.04 ships 3.12).
#  - build-essential, python3.12-dev: source builds for deps without wheels.
#  - libopenmpi-dev, openmpi-bin: kept ONLY so mpi4py builds/imports (parity
#    with the CUDA image). Multi-node launching is done by the host mpiexec.
#  - git, ca-certificates, wget, gnupg: pip git+ URLs (lightning fork) and the
#    Intel GPU apt repo key.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv \
        build-essential git ca-certificates wget gnupg \
        libopenmpi-dev openmpi-bin \
    && rm -rf /var/lib/apt/lists/*

# oras — pulls the GHCR weights bundle (see scripts/weights_bundle/ and the
# BIOM3_WEIGHTS_BUNDLE hook in docker/entrypoint.sh). This variant is amd64-only,
# but TARGETARCH is used anyway so the line stays correct if that ever changes.
ARG ORAS_VERSION=1.3.3
ARG TARGETARCH
RUN wget -qO /tmp/oras.tar.gz \
        "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && tar -xzf /tmp/oras.tar.gz -C /usr/local/bin oras \
    && rm /tmp/oras.tar.gz \
    && oras version

# Intel GPU user-space runtime (Level-Zero loader + Intel L0 GPU driver + OpenCL
# ICD) from Intel's official GPU repo for Ubuntu 24.04 (noble). These package
# names track Intel's `unified` repo and change occasionally; if a name breaks
# the build, check https://dgpu-docs.intel.com for the current set.
RUN wget -qO - https://repositories.intel.com/gpu/intel-graphics.key \
        | gpg --dearmor -o /usr/share/keyrings/intel-graphics.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu noble unified" \
        > /etc/apt/sources.list.d/intel-gpu-noble.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        libze1 libze-intel-gpu1 intel-opencl-icd clinfo \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf libze_loader.so.1 /usr/lib/x86_64-linux-gnu/libze_loader.so

# oneCCL dlopen()s the unversioned `libze_loader.so`, which only the -dev package
# provides; libze1 ships just the .so.1 soname. Without the symlink above, oneCCL
# logs "could not open the library: libze_loader.so", never initializes ze_data,
# and every collective fails with "ze_data was not initialized" — while torch
# itself works, since it links .so.1 directly.

ENV VIRTUAL_ENV=/opt/venv
RUN python3.12 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --upgrade pip setuptools wheel

# Torch with the +xpu wheel (native torch.xpu; pulls pytorch-triton-xpu). Must
# come before requirements so the pinned torch isn't replaced by a CPU wheel
# during dependency resolution. This is the XPU analog of the CUDA image's
# cu129 index.
#
# Pinned to 2.8.0 to pair with IPEX 2.8.10+xpu below, which is the newest
# public XPU build. Aurora's `module load frameworks` runs torch 2.10.0a0 with a
# matching non-public IPEX 2.10.10; the container cannot reproduce that pair.
RUN pip install torch==2.8.0 torchvision \
        --index-url https://download.pytorch.org/whl/xpu

# IPEX is not required by anything here — the lightning fork's XPUAccelerator
# gate on intel_extension_for_pytorch was removed in addison-nm/lightning#1, and
# BioM3's own code never imports it. It is retained because it is part of the
# torch 2.8 stack this image was validated against; dropping it belongs with the
# move to torch 2.10, not before it.
# Only Intel's index carries the +xpu builds (PyPI ships CPU-only wheels).
#
# torch and torchvision are repeated here with explicit +xpu local versions.
# Without them pip satisfies IPEX's `torch` requirement from PyPI, which serves
# a CPU-only wheel — that silently replaces torch 2.8.0+xpu above and leaves
# torchvision built against a torch that is no longer installed.
RUN pip install intel-extension-for-pytorch==2.8.10+xpu \
        torch==2.8.0+xpu torchvision==0.23.0+xpu \
        --extra-index-url https://download.pytorch.org/whl/xpu \
        --extra-index-url https://pytorch-extension.intel.com/release-whl/stable/xpu/us/

# Custom lightning fork with Intel-GPU support, matching the bare-metal Aurora
# install in docs/setup/setup_aurora.md. Installed before requirements so it,
# not stock pytorch-lightning, provides the Lightning layer.
#
# setuptools<82 is required: the fork's setup.py imports pkg_resources, which
# setuptools removed in 82.0.0, and --no-build-isolation makes it use the
# setuptools installed here.
#
# Pinned to a commit: an unpinned branch makes the image unreproducible, and
# Docker cannot tell that the branch moved, so it serves a stale cached layer
# until something else invalidates it.
ARG LIGHTNING_REF=5116b36e81d6be8d4c466179f3a47dd528d95c0f
RUN pip install "setuptools<82" \
    && pip install --no-build-isolation \
        "git+https://github.com/addison-nm/lightning.git@${LIGHTNING_REF}"

# Requirements layer, cached independently of the source. aurora-container.txt
# is the fully-pinned set for the container (the bare-metal requirements/aurora.txt
# leans on `module load frameworks` for torch, which a container cannot).
WORKDIR /app
COPY requirements/ /app/requirements/
RUN pip install -c requirements/constraints-xpu.txt \
        -r requirements/aurora-container.txt \
        --extra-index-url https://download.pytorch.org/whl/xpu \
        --extra-index-url https://pytorch-extension.intel.com/release-whl/stable/xpu/us/

# BioM3 source. Explicit paths (no `COPY . .`) so we never bake weights/, data/,
# outputs/, logs/, or jobs/ into the image. configs/ IS baked in (tiny, versioned,
# matches the code revision). Keep in sync with Dockerfile.cuda.
COPY pyproject.toml environment.sh README.md /app/
COPY src/      /app/src/
COPY scripts/  /app/scripts/
COPY tests/    /app/tests/
COPY configs/  /app/configs/

# Editable install with the `app` extra (streamlit). A benign dependency-conflict
# warning is expected here (the lightning fork vs pyproject's pin) — the same is
# noted for the bare-metal Aurora install; the install still works.
RUN pip install -c requirements/constraints-xpu.txt -e ".[app]" \
        --extra-index-url https://download.pytorch.org/whl/xpu \
        --extra-index-url https://pytorch-extension.intel.com/release-whl/stable/xpu/us/ \
    && mkdir -p /app/weights /app/data /app/outputs /app/logs

# Shared entrypoint (device-agnostic).
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
